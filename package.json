{
  "name": "mnn1-belajar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "validate:partikel": "tsx tools/validate_partikel.ts",
    "validate:susun": "tsx tools/validate_susun.ts",
    "audit": "tsx tools/audit_kelengkapan.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx tools/validate.ts && tsx tools/validate_partikel.ts && tsx tools/validate_susun.ts && tsc --noEmit",
    "check:full": "tsx tools/validate.ts && tsx tools/validate_partikel.ts && tsx tools/validate_susun.ts && tsc --noEmit && vitest run && vite build",
    "map": "tsx tools/map.ts",
    "gen:meta": "tsx tools/gen-meta.ts",
    "gen:kamus": "tsx tools/gen-kamus.ts",
    "find": "tsx tools/find.ts",
    "guard": "tsx tools/validate.ts && tsx tools/validate_partikel.ts && tsx tools/validate_susun.ts && tsx tools/audit_kelengkapan.ts && tsx tools/guard.ts",
    "verify": "npm run check:full && node tools/screenshot.mjs",
    "add:bab": "tsx tools/new-bab.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.5.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vitest": "^5.0.5"
  }
}
